# Postgres
POSTGRES_DB=sw_ez
POSTGRES_USER=sw_ez
POSTGRES_PASSWORD=replace_me_postgres_password
DATABASE_SCHEMA=chapter_studio

# Redis
REDIS_PASSWORD=replace_me_redis_password

# Qdrant
QDRANT_API_KEY=replace_me_qdrant_api_key

# MinIO / S3 local media storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENABLED=true
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=sw-ez-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL_BASE=http://localhost:9000/sw-ez-media

# Spring Boot
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
SPRING_DATA_REDIS_PORT=6379
JWT_SECRET=replace_me_with_32_chars_minimum_random_secret
APP_FASTAPI_BASE_URL=http://sw-ez-backend-fastapi-api:8082
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# 프론트엔드 빌드 시점 API 기준 경로
VITE_API_BASE_SPRING=http://localhost
VITE_API_BASE_FASTAPI=http://localhost/fastapi

# FastAPI AI 모델 라우팅
AI_MODEL=gemini_flash
ACTIVE_TEXT_MODEL=gemini_flash
AI_MODEL_OCR=gemini-ocr
AI_MODEL_ASR=gemini-asr
AI_MODEL_TTS=gemini-tts

# AI 제공자 키
GOOGLE_API_KEY=replace_me_google_api_key
GEMINI_API_KEY=
ANTHROPIC_API_KEY=replace_me_anthropic_api_key_if_using_claude

# ExamForge
EXAMFORGE_ANSWER_KEY_SECRET=replace_me_with_32_chars_minimum_random_secret

# FastAPI 작업 큐
AGENT_JOB_STORE=redis
AGENT_JOB_STORE_STRICT=1
AGENT_JOB_EXECUTOR=celery

# Spring과 FastAPI가 공유하는 인증 키 (32자 이상 무작위 문자열)
# Spring의 FASTAPI_API_KEY와 FastAPI의 FASTAPI_API_KEY에 동일 값을 주입한다
FASTAPI_API_KEY=replace_me_with_32_chars_minimum_random_secret

# AI 역할별 모델 라우팅 (선택)
ACTIVE_PLANNER_MODEL=gemini_flash
ACTIVE_VERIFIER_MODEL=gemini_flash
ACTIVE_TTS_MODEL=gemini_tts
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TEXT_MODEL=gemini-3.5-flash
KANANA_POLISH_ENABLED=false
CHAPTERSTUDIO_PARALLEL_VERIFY=false

# Gemini 503/429 대응 설정
GEMINI_REQUEST_INTERVAL_MS=2000
GEMINI_TEXT_MAX_CONCURRENCY=1
GEMINI_TEXT_RETRY_ATTEMPTS=5
GEMINI_TEXT_RETRY_INITIAL_MS=1000
GEMINI_TEXT_RETRY_MAX_MS=8000
GEMINI_TEXT_TIMEOUT_MS=120000
GEMINI_TEXT_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.1-flash,gemini-2.5-flash
TEXT_FALLBACK_AFTER_FAILURES=1

# 텍스트 폴백 프로바이더 키 (선택)
CLAUDE_SONNET_API_KEY=
OPENAI_API_KEY=
OPENAI_FALLBACK_ENABLED=true

# 개발자 데모 로그인 버튼(프론트 빌드 인자). 로컬에서만 켠다
VITE_DEV_LOGIN=true
