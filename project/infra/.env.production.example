# 프로덕션 환경변수 예시
# 운영 값 주입 기준만 기록한다.
# 실제 비밀값은 배포 환경의 .env 또는 시크릿 매니저에만 저장한다.

# 배포 전에 반드시 설정해야 하는 보안 항목
# 이 항목들이 빠지면 인증 off·Swagger 노출·CORS 와일드카드 상태가 된다.

# 실행 환경은 production으로 고정한다 (development이면 Swagger·디버그 모드가 열린다)
ENVIRONMENT=production
APP_ENV=production

# Spring과 FastAPI 사이의 내부 인증 키. 32자 이상 무작위 문자열이어야 한다.
# Spring의 app.fastapi.api-key와 FastAPI의 FASTAPI_API_KEY에 동일 값을 주입한다.
# 값이 빠지면 Spring의 5개 FastAPI 호출부가 전부 401을 받는다.
FASTAPI_API_KEY=<32-char-random-required>

# 허용할 프론트엔드 도메인. 와일드카드(*)는 쓰지 않는다.
# 복수 도메인은 쉼표로 구분: https://app.example.com,https://www.example.com
CORS_ORIGINS=https://your-frontend.example.com

# FastAPI 요청 속도 제한 (분당 요청 수 / 버스트 허용 수)
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# AI 제공자 키. gemini-tts/LLM을 쓰면 둘 중 하나는 필수다
GEMINI_API_KEY=
GOOGLE_API_KEY=

# 관리형 PostgreSQL
DATABASE_URL=postgresql://<db_user>:<db_password>@<managed-postgres-host>:5432/<db_name>
DATABASE_SCHEMA=chapter_studio

# 외부 Redis: API 작업 상태, Celery 브로커, 결과 저장소를 분리한다.
REDIS_URL=redis://:<redis_password>@<redis-host>:6379/0
CELERY_BROKER_URL=redis://:<redis_password>@<redis-host>:6379/1
CELERY_RESULT_BACKEND=redis://:<redis_password>@<redis-host>:6379/2
AGENT_JOB_REDIS_URL=redis://:<redis_password>@<redis-host>:6379/3
AGENT_JOB_STORE=redis
AGENT_JOB_STORE_STRICT=1
AGENT_JOB_EXECUTOR=celery

# 외부 Qdrant
QDRANT_URL=https://<qdrant-host>:6333
OCR_V1_QDRANT_URL=https://<qdrant-host>:6333
QDRANT_API_KEY=<qdrant_api_key>

# 실제 S3 또는 호환 객체 저장소
S3_ENABLED=true
S3_ENDPOINT_URL=
S3_REGION=ap-northeast-2
S3_BUCKET=<s3_bucket_name>
S3_ACCESS_KEY=<s3_access_key>
S3_SECRET_KEY=<s3_secret_key>
S3_PUBLIC_URL_BASE=https://<cdn-or-bucket-host>

# FastAPI 모델 라우팅
AI_MODEL=gemini_flash
ACTIVE_TEXT_MODEL=gemini_flash
AI_MODEL_OCR=gemini-ocr
AI_MODEL_ASR=gemini-asr
AI_MODEL_TTS=gemini-tts

# AI 제공자 키
GOOGLE_API_KEY=<google_api_key>
GEMINI_API_KEY=<gemini_api_key>
ANTHROPIC_API_KEY=<anthropic_api_key_if_using_claude>

# ExamForge
EXAMFORGE_ANSWER_KEY_SECRET=<32_chars_minimum_random_secret>

# 프론트엔드 공개 API 기준 경로
VITE_API_BASE_SPRING=https://<app-host>
VITE_API_BASE_FASTAPI=https://<app-host>/fastapi
VITE_API_BASE_RUST=

# Spring이 FastAPI를 직접 호출할 때 쓰는 내부 주소
APP_FASTAPI_BASE_URL=http://<fastapi-internal-host>:8082
