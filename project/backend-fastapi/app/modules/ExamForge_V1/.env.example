# ExamForge_V1 환경 변수
# AI 커넥터 설정
ANTHROPIC_API_KEY=
# Claude Sonnet 키(비우면 ANTHROPIC_API_KEY를 쓴다)
CLAUDE_SONNET_API_KEY=
# Gemini는 EXAMFORGE_GEMINI_FALLBACK=true이거나 gemini_flash를 고를 때만 쓴다
GOOGLE_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
EXAMFORGE_GEMINI_FALLBACK=false
# OpenAI는 기본 체인에 없다
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-nano
OPENAI_OCR_MODEL=gpt-5.5
OPENAI_ASR_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_FALLBACK_ENABLED=false
# 문제 생성·출제 계획: Modal Qwen3.6-27B → Claude Sonnet
EXAMFORGE_ACTIVE_TEXT_MODEL=qwen27b_modal
EXAMFORGE_ACTIVE_PLANNER_MODEL=
# 정답 교차 검증·표적 교정(비우면 claude_sonnet)
EXAMFORGE_ACTIVE_VERIFIER_MODEL=
# 정답 키 위변조를 막는 HMAC secret. 32자 이상 무작위 문자열이어야 하며 짧으면 시작 시 실패한다
EXAMFORGE_ANSWER_KEY_SECRET=

# 품질 스위치
# 정답 검증을 관측용으로만 쓰고 재시도·교정 판단에는 쓰지 않는다
EXAMFORGE_VERIFICATION_ADVISORY=false
# 검증 실패 문항 표적 교정(false면 blind 재생성)
EXAMFORGE_TARGETED_REPAIR=true
# 오답 선택지 재작성(코드가 많은 보기에서 false로 끄면 처음 보기를 쓴다)
EXAMFORGE_DISTRACTOR_REWRITE=true

# 파이프라인 설정
MAX_RETRIES=3
GENERATION_CONCURRENCY=4
VERIFICATION_CONCURRENCY=3

# 서버 설정
MOCK_EXAM_PORT=8900

# Gemini CLI 테스트 전용 패스스루
# 로컬 live 보고서를 만들 때만 true로 둔다.
EXAMFORGE_GEMINI_CLI_TEST_ENABLED=false
EXAMFORGE_GEMINI_CLI_MODEL=gemini-2.5-flash
EXAMFORGE_GEMINI_CLI_TIMEOUT_SEC=240
EXAMFORGE_GEMINI_CLI_REPORT_DIR=app/modules/ExamForge_V1/artifacts/gemini_cli_reports
