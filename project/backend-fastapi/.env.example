# backend-fastapi 환경변수
# 시크릿(API 키·비밀번호)은 .env 에만 채운다.

# 서버 기본 설정
# 프로덕션 배포 기준 예시다. 로컬 개발은 실제 .env에서 development/local로 덮어쓴다.
APP_ENV=production
ENVIRONMENT=production
APP_PORT=8000
LOG_LEVEL=info
# 배포자가 실제 PostgreSQL DSN을 주입한다. 예시 값이나 changeme 비밀번호를 운영에 쓰지 않는다.
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>
DATABASE_SCHEMA=chapter_studio
REDIS_URL=redis://:<spring_redis_password>@<spring_private_ip>:6379/4
QDRANT_URL=http://qdrant:6333
OCR_V1_QDRANT_URL=http://qdrant:6333
# 품질 게이트에 걸려 MinerU로 다시 뽑은 페이지만 Kanana-2로 교정한다(기본 true)
OCR_V1_FALLBACK_KANANA_POLISH=true
# Kanana-2 교정이 실패하면 Claude로 한 번 더 교정한다(기본 true)
OCR_V1_FALLBACK_CLAUDE_POLISH=true
# 임베딩·리랭커 실행 위치. modal(기본) 또는 local(FastAPI 프로세스 안)
OCR_V1_EMBED_BACKEND=modal
OCR_V1_MODAL_EMBED_APP_NAME=ocr-bge-m3
QDRANT_API_KEY=

# S3 객체 저장소. false면 로컬 media/ 에 저장한다.
S3_ENABLED=false
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=sw-ez-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL_BASE=

# DB 연결 재시도. DB 컨테이너가 늦게 떠도 FastAPI 부팅이 멈추지 않는다.
DB_POOL_INIT_RETRIES=5
DB_POOL_INIT_BACKOFF_SEC=1
DB_POOL_INIT_MAX_BACKOFF_SEC=5

# AI 모델 선택
# 커리큘럼 설계는 Claude Opus 4.6(opus46, ACTIVE_PLANNER_MODEL) 1회만 쓴다.
# 검증·채팅·채점은 Claude Sonnet(claude_sonnet)이다.
# 강의·문제 생성은 Modal Qwen3.6-27B FP8(vLLM)이 1순위이고 실패하면 Claude로 넘어간다.
# 폴백 정책: 커리큘럼 외 전부 Modal → Claude. Gemini/OpenAI는 기본 체인에 없다.
AI_MODEL=claude_sonnet
# 공용 텍스트 커넥터
ACTIVE_TEXT_MODEL=claude_sonnet
# Chat_V1 채팅 모델. ACTIVE_TEXT_MODEL과 따로 고른다(기본 claude_sonnet)
CHAT_V1_TEXT_MODEL=claude_sonnet
# 강의 생성. qwen27b_sonnet_fallback = Modal 1순위 + Claude 폴백. qwen27b_modal 은 폴백 없이 Modal만 쓴다.
LECTURE_TEXT_MODEL=qwen27b_sonnet_fallback
# ExamForge 모의고사. 문제 생성·출제 계획은 Modal(qwen27b_modal)이 1순위이고 Claude 키가 있으면 Claude로 넘어간다.
EXAMFORGE_ACTIVE_TEXT_MODEL=qwen27b_modal
EXAMFORGE_ACTIVE_PLANNER_MODEL=qwen27b_modal
EXAMFORGE_ACTIVE_VERIFIER_MODEL=claude_sonnet
# true면 Claude 다음에 Gemini를 한 번 더 시도한다(기본 false)
EXAMFORGE_GEMINI_FALLBACK=false
# 과제 채점도 Claude만 쓴다. true면 Claude 실패 시 Gemini로 넘어간다(기본 false)
ASSIGNMENT_GRADER_GEMINI_FALLBACK=false
AI_MODEL_TTS=qwen3-tts-modal
AI_MODEL_ASR=whisper-modal
AI_MODEL_OCR=gemini-ocr
AI_OCR=gemini_ocr
AI_MODEL_DENOISE=mossformer2-se-48k
MOSSFORMER2_SE_MODEL_PATH=
MOSSFORMER2_SR_MODEL_PATH=
AI_MODEL_POSTPROC=kanana2-modal
AI_MODEL_VOICE=gemini-flash-live

# 외부 API 키 (값은 .env 에만)
# Claude 키는 ANTHROPIC_API_KEY 또는 CLAUDE_SONNET_API_KEY 중 하나면 된다.
# GOOGLE_API_KEY 또는 GEMINI_API_KEY는 Gemini 경로를 명시 선택할 때만 필요하다.
ANTHROPIC_API_KEY=
CLAUDE_SONNET_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Claude Sonnet 설정(검증·채팅·채점).
# API 키: CLAUDE_SONNET_API_KEY 또는 ANTHROPIC_API_KEY
CLAUDE_SONNET_MODEL=claude-sonnet-4-6
CLAUDE_SONNET_MAX_CONCURRENCY=4
CLAUDE_SONNET_TIMEOUT_SEC=300

# Gemini google-genai 텍스트 설정 (기본: gemini-3.5-flash)
GEMINI_TEXT_MODEL=gemini-3.5-flash

# Gemini Flash Live 설정
GEMINI_FLASH_LIVE_MODEL=gemini-2.0-flash-live-001
GEMINI_FLASH_LIVE_TIMEOUT_SEC=60
# Gemini 멀티모달 커넥터 기본값
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GEMINI_ASR_MODEL=gemini-3.5-flash
GEMINI_OCR_MODEL=gemini-2.5-flash

# OpenAI 폴백. 기본 꺼짐이며, Gemini 를 명시 선택한 경로에서 OPENAI_FALLBACK_ENABLED=true 일 때만 쓴다.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-nano
OPENAI_OCR_MODEL=gpt-5.5
OPENAI_ASR_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_FALLBACK_ENABLED=false

# Modal GPU 배포 (값은 .env 에만)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# API 컨테이너가 뜰 때 Modal 앱을 deploy 한다(기본 켜짐, 0/false 로 끈다).
MODAL_ENSURE_DEPLOY=
# modal deploy 타임아웃(초). 기본 180
MODAL_DEPLOY_TIMEOUT=180
# 공백으로 구분한 경로 목록. 비우면 강의 qwen27b, kanana2 오타 교정, qwen3-tts, asr-whisper, ocr-bge-m3 5개 앱을 배포한다.
MODAL_DEPLOY_APP_PATHS=
# 경로 하나만 배포할 때 쓴다(예전 설정 호환).
MODAL_DEPLOY_APP_PATH=
# 보조 Modal 계정 토큰(SUB 계정으로 배포할 때, 값은 .env 에만)
SUB_MODAL_TOKEN_ID=
SUB_MODAL_TOKEN_SECRET=
MODAL_PROFILE=
CHAPTERSTUDIO_MODAL_APP_NAME=chapterstudio-qwen27b
CHAPTERSTUDIO_MODAL_MODEL_ID=Qwen/Qwen3.6-27B-FP8
CHAPTERSTUDIO_MODAL_MODEL_ALIAS=chapterstudio-qwen27b
CHAPTERSTUDIO_MODAL_MAX_MODEL_LEN=131072
CHAPTERSTUDIO_MODAL_MAX_NUM_BATCHED_TOKENS=32768
CHAPTERSTUDIO_MODAL_LANGUAGE_MODEL_ONLY=0
# Modal GPU 작업이 끝나면 실행 중인 컨테이너를 바로 stop 한다(배포는 유지).
MODAL_GPU_RELEASE_ENABLED=true
# 비우면 REDIS_URL로 워커·강의별 GPU 사용 카운트를 센다(Redis가 없으면 프로세스 메모리).
# MODAL_GPU_REDIS_URL=redis://:<spring_redis_password>@<spring_private_ip>:6379/4
# ChapterStudio 커리큘럼 설계(강의당 1회)
ACTIVE_PLANNER_MODEL=opus46
ACTIVE_TTS_MODEL=qwen3_tts_modal
# true면 Modal TTS 뒤에 Gemini → OpenAI TTS를 붙인다(기본 false)
TTS_CLOUD_FALLBACK_ENABLED=false
# 강의 내용(사실·논리) 검증 커넥터. 미설정 시 claude_sonnet
ACTIVE_VERIFIER_MODEL=claude_sonnet
# 강의 생성 뒤 분량·형식 자체 점검과 부분 수정(기본 true)
CHAPTERSTUDIO_LESSON_SELF_REPAIR=true
# 강의 내용(사실·논리) 검증 단계(기본 true)
CHAPTERSTUDIO_CONTENT_VERIFY=true
# 슬라이드 사이 음성대본 도입부를 이어지게 다시 쓰기(기본 true)
VOICE_COHESION_ENABLED=true
# 퀴즈 보기를 섞어 정답 위치 고르게 하기(기본 true)
QUIZ_BALANCE_ENABLED=true
QWEN_APP_NAME=chapterstudio-qwen27b
KANANA_MODAL_APP_NAME=kanana2-typofix
KANANA_MODAL_MODEL_ID=NotoriousH2/kanana-2-30b-a3b-instruct-2601-awq-w4a16
KANANA_POLISH_ENABLED=0
KANANA_POLISH_MAX_CONCURRENCY=8
TTS_ENDPOINT=
# Modal TTS 엔드포인트 인증 토큰과 호출 URL(값은 .env 에만)
QWEN3_TTS_MODAL_TOKEN=
# QWEN3_TTS_MODAL_URL 을 넣으면 Modal SDK(remote.aio) 대신 웹 엔드포인트에 HTTP POST 한다.
# 비우면 SDK 경로다. 타임아웃은 둘 다 QWEN3_TTS_TIMEOUT_SEC 를 쓴다.
QWEN3_TTS_MODAL_URL=

# 강의 생성 때 슬라이드별 튜터 음성을 바로 만든다(1=켬, Modal TTS 호출). 기본 0
TTS_AUTOGEN_ENABLED=0
# 문장 세그먼트 사이 무음 길이(ms). 0~500, 기본 60
TTS_SEGMENT_PAUSE_MS=60
# 첫 문장과 끝 문장 끝에 물결표(~)를 붙여 말투를 부드럽게 한다. 기본 true
TTS_SELECTIVE_TILDE=true
# TTS Modal 호출 타임아웃(초). 콜드스타트 때 모델 풀 로드가 약 360초라 기본 900
QWEN3_TTS_TIMEOUT_SEC=900
# 긴 음성대본의 세그먼트 병렬 합성 수(1~POOL_SIZE). 기본 4
QWEN3_TTS_SEGMENT_CONCURRENCY=4
# 음성을 몰아서 만들기 전에 한 번 워밍업해 콜드스타트 타임아웃을 피한다. 기본 true
TTS_WARMUP_ENABLED=true

# ASR 폴백 tier 순서(AI_MODEL_ASR=asr-fallback 일 때). 비우면 whisper-modal 하나다.
ASR_FALLBACK_TIERS=whisper-modal
# true면 Whisper 실패 때 Gemini ASR로 넘긴다(기본 false)
ASR_GEMINI_FALLBACK=false
# Whisper V3 Turbo Modal 앱
ASR_WHISPER_MODAL_APP_NAME=asr-whisper-v3-turbo
ASR_WHISPER_MODAL_GPU=L4
ASR_WHISPER_MODAL_SCALEDOWN_SEC=30
ASR_WHISPER_MODAL_TIMEOUT_SEC=300
ASR_FALLBACK_QUALITY_PASS=0.6
ASR_FALLBACK_MIN_CHARS_PER_SEC=1.5
ASR_FALLBACK_MAX_REPEAT_NGRAM=3

# OCR
NEMOTRON_OCR_V2_MODAL_URL=
NEMOTRON_OCR_TIMEOUT_SEC=60.0
NEMOTRON_OCR_RETRIES=1
MAX_PDF_UPLOAD_SIZE_BYTES=1610612736

# Celery
CELERY_BROKER_URL=redis://:<spring_redis_password>@<spring_private_ip>:6379/1
CELERY_RESULT_BACKEND=redis://:<spring_redis_password>@<spring_private_ip>:6379/2

# Agent Orchestrator
AGENT_JOB_STORE=memory
AGENT_JOB_REDIS_URL=redis://:<spring_redis_password>@<spring_private_ip>:6379/3
AGENT_JOB_STORE_STRICT=0
AGENT_JOB_EXECUTOR=background
AGENT_CALLBACK_MAX_ATTEMPTS=3
AGENT_CALLBACK_TIMEOUT_SEC=5
GENERATION_CONCURRENCY=4
VERIFICATION_CONCURRENCY=2

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_bot_username

# 보안 / Rate Limit
# Spring→FastAPI 인증키. Spring .env의 FASTAPI_API_KEY와 같아야 한다.
# 비우면 API 인증이 꺼지므로 운영에서는 32자 이상 무작위 문자열을 넣는다.
FASTAPI_API_KEY=
# FastAPI→Spring 내부 콜백 토큰. Spring InternalTokenFilter의 APP_INTERNAL_TOKEN과 같아야 한다.
# 값이 다르거나 비면 /internal/** 콜백이 403으로 거절된다.
APP_INTERNAL_TOKEN=change-me-must-match-spring
# FastAPI→Spring 콜백 베이스 URL(AssignmentGrader 콜백).
# Docker Compose: http://sw-ez-backend-spring-api:8080/api, 로컬: http://localhost:8080/api
SPRING_BASE_URL=http://localhost:8080/api
# 정답 키 위변조를 막는 HMAC secret. 배포자가 32자 이상 무작위 문자열을 넣는다.
EXAMFORGE_ANSWER_KEY_SECRET=
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10
# 프로덕션은 실제 프론트 도메인을 쉼표로 지정한다. 와일드카드(*)를 운영에 쓰지 않는다.
CORS_ORIGINS=https://your-frontend.example.com

# 로컬 Mac 전용 모델 경로. MLX/GGUF로 로컬 실행할 때만 채우고 Modal 경로에서는 비운다.
# QWEN3_TTS_MODEL_PATH 는 _mlx_audio_runtime.py 가 읽는다.
QWEN3_TTS_MODEL_PATH=

# ExamForge 품질 스위치
# true면 정답 검증 결과를 기록만 하고 재시도·교정 판단에는 쓰지 않는다.
EXAMFORGE_VERIFICATION_ADVISORY=false
# 검증에 실패한 문항만 고치는 경로(기본 true). false면 그 문항을 처음부터 다시 만든다.
EXAMFORGE_TARGETED_REPAIR=true
# 오답 보기 재작성 단계(기본 true). false면 처음 만든 보기를 그대로 둔다.
EXAMFORGE_DISTRACTOR_REWRITE=true

# ExamForge Gemini CLI 테스트용
EXAMFORGE_GEMINI_CLI_TEST_ENABLED=false
EXAMFORGE_GEMINI_CLI_MODEL=gemini-2.5-flash
EXAMFORGE_GEMINI_CLI_TIMEOUT_SEC=240
EXAMFORGE_GEMINI_CLI_REPORT_DIR=app/modules/ExamForge_V1/artifacts/gemini_cli_reports

# Gemini 안정화(503/429 대응). Gemini 경로를 명시 선택했을 때만 쓰인다.
# 전역(채팅·강의) Gemini 호출 시작 간격(ms). 0이면 끈다.
GEMINI_REQUEST_INTERVAL_MS=2000
# 전역(채팅·강의) Gemini 동시 호출 상한
GEMINI_TEXT_MAX_CONCURRENCY=1
# ExamForge 전용 Gemini 레인
# 모의고사는 호출이 수십 개라 전역 2000ms 간격에 묶이면 느려져서 따로 둔다(채팅·강의에는 영향 없다).
# EXAMFORGE_GEMINI_CONCURRENCY: 동시 호출 수(기본 3)
# EXAMFORGE_GEMINI_INTERVAL_MS: 호출 시작 간격(ms, 기본 600)
EXAMFORGE_GEMINI_CONCURRENCY=3
EXAMFORGE_GEMINI_INTERVAL_MS=600
# 지수 백오프 재시도: 시도 횟수 / 초기 지연 / 최대 지연 (1s, 2s, 4s, 8s)
GEMINI_TEXT_RETRY_ATTEMPTS=5
GEMINI_TEXT_RETRY_INITIAL_MS=1000
GEMINI_TEXT_RETRY_MAX_MS=8000
# Gemini 단일 호출 타임아웃(ms)
GEMINI_TEXT_TIMEOUT_MS=120000
# Gemini 안에서의 모델 폴백 순서(503/429 때 다음 모델로)
GEMINI_TEXT_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.1-flash,gemini-2.5-flash
# 다른 프로바이더로 넘어가는 연속 실패 횟수
TEXT_FALLBACK_AFTER_FAILURES=1
# 폴백으로 넘어간 뒤 주 커넥터 복귀를 시도하는 간격(초). 0 이하면 복귀하지 않는다.
TEXT_FALLBACK_RECOVERY_SEC=60

# ChapterStudio 생성 제어
CHAPTERSTUDIO_PARALLEL_VERIFY=false
# 아래 4개 키는 지금 코드가 읽지 않는다(로컬 강의 폴백용 예약).
CHAPTERSTUDIO_LESSON_MAX_TOKENS=24000
CHAPTERSTUDIO_LESSON_GENERATION_TIMEOUT_SEC=120
CHAPTERSTUDIO_LOCAL_LESSON_FALLBACK=true
CHAPTERSTUDIO_FORCE_LOCAL_LESSON_FALLBACK=false

# ExamForge 생성 제어
# 아래 3개 키는 지금 코드가 읽지 않는다(비동기 생성 타임아웃·로컬 폴백용 예약).
EXAMFORGE_ASYNC_GENERATION_TIMEOUT_SEC=45
EXAMFORGE_LOCAL_FALLBACK_ENABLED=true
EXAMFORGE_FORCE_LOCAL_FALLBACK=false

# TTS 합성 동시성
TTS_SYNTH_CONCURRENCY=1
