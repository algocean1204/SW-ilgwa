# 백엔드 API 베이스 URL (개발 환경)
# Spring Boot: 메인 REST API + SSE 실시간 강의 스트리밍
VITE_API_BASE_SPRING=http://localhost:8080
# FastAPI + Celery: AI 파이프라인 (Claude, Modal GPU, OCR 추론). 포트 8082 고정.
VITE_API_BASE_FASTAPI=http://localhost:8082

# Google OAuth: Google Cloud Console의 OAuth Client ID
VITE_GOOGLE_CLIENT_ID=

# Kakao OAuth: Kakao Developers의 REST API 키와 등록한 Redirect URI
VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_REDIRECT_URI=http://localhost:4173/oauth/kakao

# 개발 전용 로그인 (OAuth 없는 로컬 환경). true이면 /auth/dev-login 엔드포인트 활성화
# 운영 빌드에서는 반드시 false로 설정한다
VITE_DEV_LOGIN=false
