# Rust 애플리케이션 환경변수 (로컬 dev)
# infra 레포의 sw-ez-shared 네트워크에 조인하면 서비스명으로 접속한다

# 서버
RUST_LOG=info
APP_PORT=8081

# Postgres (sqlx 연결 문자열)
DATABASE_URL=postgres://sw_ez:changeme@postgres:5432/sw_ez

# Redis
REDIS_URL=redis://:changeme@redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333
# Qdrant API 키. infra/.env의 QDRANT_API_KEY와 같은 값이며 시크릿은 .env에만 둔다
QDRANT_API_KEY=replace_with_qdrant_api_key
