# VCS 메타데이터는 이미지에 넣지 않는다
.git/
.gitignore
.gitattributes

# IDE 설정 파일은 빌드와 무관하다
.idea/
.vscode/
*.iml

# 이미지 안에서 새로 빌드하므로 로컬 Gradle 산출물은 제외한다
build/
.gradle/
out/

# 문서와 로그는 런타임에 필요 없다
*.md
logs/
*.log

# 시크릿이 이미지에 들어가지 않게 환경변수 파일을 제외한다
.env
.env.*
!.env.example

# macOS/Windows가 만드는 OS 메타파일
.DS_Store
Thumbs.db

# Docker 설정 파일 자체는 이미지 레이어에 넣지 않는다
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore
