# Spring 애플리케이션 환경변수 (로컬 dev)
# infra 레포의 네트워크 sw-ez-shared에 조인하면 호스트명은 서비스명으로 해결된다
# 이 파일을 .env로 복사한 뒤 실제 값으로 교체해서 사용한다

# 서버
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Postgres (infra docker-compose의 postgres 서비스)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/sw_ez
SPRING_DATASOURCE_USERNAME=sw_ez
SPRING_DATASOURCE_PASSWORD=changeme

# JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# Redis (infra docker-compose의 redis 서비스)
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=changeme

# JWT 기본값은 액세스 30분, 리프레시 14일이다. secret은 32자 이상 랜덤 문자열을 쓴다
JWT_SECRET=change_me_to_at_least_32_chars_random_string
JWT_ACCESS_EXPIRY_MS=1800000
JWT_REFRESH_EXPIRY_MS=1209600000

# Google OAuth: Google Cloud Console에서 발급한 클라이언트 ID
GOOGLE_CLIENT_ID=

# Kakao OAuth: Kakao Developers의 REST API 키와 Client Secret
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Kakao Redirect URI: Kakao Developers에 등록한 URI (환경마다 다르다)
# 예) 로컬: http://localhost:3000/oauth/kakao  운영: https://example.com/oauth/kakao
KAKAO_REDIRECT_URI=

# Auth Cookie: 로컬 HTTP는 secure=false, SameSite=Lax를 쓴다
# 운영(HTTPS)은 secure=true, SameSite=Strict|None
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_DOMAIN=

# CORS: 프론트 dev 서버 포트 4173 (frontend-web vite.config.ts의 strictPort 값)
# 운영 배포 시 실제 도메인으로 교체한다
APP_CORS_ALLOWED_ORIGINS=http://localhost:4173

# Dev Login은 로컬 데모에서만 true로 둔다. false이면 /auth/dev-login이 AUTH_008을 반환한다
DEV_LOGIN_ENABLED=false

# FastAPI 아웃바운드 베이스 URL. FastAPI 포트는 8082로 고정이다.
# Docker Compose(sw-ez-shared) 환경: http://sw-ez-backend-fastapi-api:8082
# 로컬 직접 실행: http://localhost:8082
# ExamForge RestClient(examForgeRestClient 빈)도 이 값을 재사용한다
APP_FASTAPI_BASE_URL=http://sw-ez-backend-fastapi-api:8082

# Spring→FastAPI 아웃바운드 API 키. FastAPI .env의 FASTAPI_API_KEY와 같아야 한다
# 미설정 또는 빈값이면 X-API-Key 헤더를 붙이지 않는다 (FastAPI 인증 비활성화 상태 허용)
# ExamForge RestClient도 이 키를 재사용한다
FASTAPI_API_KEY=

# ExamForge 채점의 answer_key_seal 무결성 검증 시크릿
# FastAPI가 시험지 생성 시 seal을 서명할 때 사용한 키와 동일 값을 설정한다
# Spring은 seal을 DB에 보관하고 FastAPI로 넘기기만 하므로 빈값이어도 부팅에는 영향이 없다
# 실제 검증은 FastAPI가 한다
EXAMFORGE_ANSWER_KEY_SECRET=

# ExamForge Cutover 플래그. MockExamService의 생성·제출·상세조회를 examgrading 경로로 바꾼다
# false(기본): 레거시 MCQ 경로 유지. true: examgrading 신규 lifecycle로 위임
# 기동 시 한 번 읽으므로 값을 바꾼 뒤 컨테이너를 재시작해야 적용된다 (이미지 재빌드는 필요 없다)
APP_EXAMGRADING_CUTOVER_ENABLED=false

# FastAPI→Spring 콜백 인증 토큰. InternalTokenFilter가 X-Internal-Token 헤더로 확인한다
# 최소 32자 이상 무작위 문자열을 사용한다
APP_INTERNAL_TOKEN=change_me_to_at_least_32_chars_random_string

# Toss Payments
TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...
TOSS_BASE_URL=https://api.tosspayments.com

# AWS S3: 음성 샘플·파일 업로드 저장소
AWS_S3_BUCKET=
AWS_S3_REGION=ap-northeast-2
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_ENDPOINT=
